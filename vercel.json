{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "landing",
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "landing/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/landing/index.html" },
    { "src": "/(.*)", "dest": "/landing/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(html|css|js|png|jpg|jpeg|webp|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
